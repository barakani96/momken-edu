{
  "id": "sis",
  "code": "MOD-SIS-01",
  "name": "Student Information System",
  "label": "Student Information System",
  "shortName": "SIS",
  "category": "Academic & Student Life",
  "version": "2.4.0",
  "status": "active",
  "description": "Authoritative institutional system of record for managing student biographical profiles, admissions, term enrollments, and family guardian linkages.",
  "icon": "Education",
  "authoritativeEntities": ["students", "admissions", "enrollments", "guardians"],
  "primaryEntity": "students",
  "entities": [
    {
      "name": "students",
      "label": "Student",
      "labelPlural": "Students",
      "isPrimary": true,
      "icon": "UserMultiple",
      "description": "Authoritative demographic, contact, and enrollment status records for registered students.",
      "schema": {
        "resource": "students",
        "label": "Student",
        "labelPlural": "Students",
        "fields": [
          { "name": "studentId", "type": "text", "label": "Student ID", "required": true, "colSpan": 6 },
          { "name": "status", "type": "select", "label": "Status", "required": true, "colSpan": 6, "options": [
            { "label": "Active", "value": "active" },
            { "label": "Pending", "value": "pending" },
            { "label": "Inactive", "value": "inactive" },
            { "label": "Graduated", "value": "graduated" }
          ]},
          { "name": "firstName", "type": "text", "label": "First Name", "required": true, "colSpan": 6 },
          { "name": "lastName", "type": "text", "label": "Last Name", "required": true, "colSpan": 6 },
          { "name": "email", "type": "email", "label": "Email Address", "required": true, "colSpan": 6 },
          { "name": "phone", "type": "phone", "label": "Contact Phone", "colSpan": 6 },
          { "name": "gradeLevel", "type": "select", "label": "Grade Level", "required": true, "colSpan": 6, "options": [
            { "label": "Grade 9 (Freshman)", "value": "Grade 9" },
            { "label": "Grade 10 (Sophomore)", "value": "Grade 10" },
            { "label": "Grade 11 (Junior)", "value": "Grade 11" },
            { "label": "Grade 12 (Senior)", "value": "Grade 12" }
          ]},
          { "name": "enrollmentDate", "type": "date", "label": "Enrollment Date", "colSpan": 6 },
          { "name": "gender", "type": "select", "label": "Gender", "colSpan": 6, "options": [
            { "label": "Male", "value": "Male" },
            { "label": "Female", "value": "Female" },
            { "label": "Other / Prefer not to say", "value": "Other" }
          ]},
          { "name": "gpa", "type": "number", "label": "Cumulative GPA", "colSpan": 6 },
          { "name": "address", "type": "textarea", "label": "Residential Address", "colSpan": 12 }
        ]
      },
      "columns": [
        { "key": "studentId", "header": "Student ID", "sortable": true, "width": "120px" },
        { "key": "name", "header": "Full Name", "sortable": true },
        { "key": "gradeLevel", "header": "Grade", "sortable": true, "width": "130px" },
        { "key": "email", "header": "Email", "sortable": true },
        { "key": "status", "header": "Status", "sortable": true, "width": "110px" },
        { "key": "enrollmentDate", "header": "Enrolled", "sortable": true, "width": "130px" }

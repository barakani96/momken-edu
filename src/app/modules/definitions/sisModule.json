        "resource": "enrollments",
        "label": "Enrollment Record",
        "labelPlural": "Enrollments",
        "fields": [
          { "name": "enrollmentCode", "type": "text", "label": "Enrollment Code", "required": true, "colSpan": 6 },
          { "name": "studentName", "type": "text", "label": "Student Name", "required": true, "colSpan": 6 },
          { "name": "academicYear", "type": "text", "label": "Academic Year", "required": true, "colSpan": 6 },
          { "name": "term", "type": "select", "label": "Academic Term", "required": true, "colSpan": 6, "options": [

  "settings": {
    "general": {
      "academicYear": "2026-2027",
      "defaultTerm": "Fall Semester",
      "defaultViewMode": "table",
      "allowQuickInlineEdit": true,
      "autoRefreshInterval": 0
    },
    "numbering": {
      "idPrefix": "STU-",
      "idSequenceStart": 1000,
      "autoGenerateStudentId": true,
      "requireNationalIdentifier": true
    },
    "admissions": {
      "maxGradeCapacity": 30,
      "enableWaitlist": true,
      "autoEnrollAcceptedAdmissions": false,
      "requireGuardianConsent": true
    },
    "governance": {
      "enableAuditLogging": true,
      "archiveRetentionYears": 7,
      "allowBulkDeletion": true,
      "readOnlyMode": false
    }
  }

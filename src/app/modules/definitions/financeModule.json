    {
      "name": "payments",
      "label": "Payment Transaction",
      "labelPlural": "Payments",
      "isPrimary": false,
      "icon": "Purchase",
      "description": "Cash receipts, credit card authorizations, ACH transactions, and wire transfers.",
      "schema": {
        "resource": "payments",
        "label": "Payment",
        "labelPlural": "Payments",
        "fields": [
          { "name": "transactionId", "type": "text", "label": "Transaction Reference", "required": true, "colSpan": 6 },
          { "name": "invoiceNumber", "type": "text", "label": "Invoice #", "required": true, "colSpan": 6 },
          { "name": "payerName", "type": "text", "label": "Payer Name", "required": true, "colSpan": 6 },
          { "name": "amount", "type": "currency", "label": "Amount ($)", "required": true, "colSpan": 6 },
          { "name": "method", "type": "select", "label": "Payment Method", "required": true, "colSpan": 6, "options": [
            { "label": "Credit Card", "value": "Credit Card" },
            { "label": "ACH / Bank Transfer", "value": "ACH" },
            { "label": "Wire Transfer", "value": "Wire" },
            { "label": "Cash / Check", "value": "Check" }
          ]},
          { "name": "paymentDate", "type": "date", "label": "Payment Date", "required": true, "colSpan": 6 },
          { "name": "status", "type": "select", "label": "Status", "required": true, "colSpan": 6, "options": [
            { "label": "Settled", "value": "settled" },
            { "label": "Processing", "value": "processing" },
            { "label": "Failed", "value": "failed" },
            { "label": "Refunded", "value": "refunded" }
          ]}
        ]
      },
      "columns": [

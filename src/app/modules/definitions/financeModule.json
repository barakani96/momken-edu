      ]
    },
    {
      "name": "feeStructures",
      "label": "Fee Schedule",
      "labelPlural": "Fee Schedules",
      "isPrimary": false,
      "icon": "Catalog",
      "description": "Standard institutional tuition rates, lab fees, technology levies, and activity fees.",

    {
      "name": "invoices",
      "label": "Tuition & Fee Invoice",
      "labelPlural": "Invoices",
      "isPrimary": true,
      "icon": "Document",
      "description": "Student tuition statements, term recurring fees, lab fees, and outstanding balances.",
      "schema": {
        "resource": "invoices",
        "label": "Invoice",
        "labelPlural": "Invoices",
        "fields": [
          { "name": "invoiceNumber", "type": "text", "label": "Invoice Number", "required": true, "colSpan": 6 },
          { "name": "studentName", "type": "text", "label": "Student Name", "required": true, "colSpan": 6 },
          { "name": "studentId", "type": "text", "label": "Student ID", "required": true, "colSpan": 6 },
          { "name": "term", "type": "select", "label": "Academic Term", "required": true, "colSpan": 6, "options": [
            { "label": "Fall 2026", "value": "Fall 2026" },
            { "label": "Spring 2027", "value": "Spring 2027" },
            { "label": "Summer 2026", "value": "Summer 2026" }
          ]},
          { "name": "totalAmount", "type": "currency", "label": "Total Amount ($)", "required": true, "colSpan": 6 },
          { "name": "paidAmount", "type": "currency", "label": "Paid Amount ($)", "colSpan": 6 },
          { "name": "dueDate", "type": "date", "label": "Due Date", "required": true, "colSpan": 6 },
          { "name": "status", "type": "select", "label": "Invoice Status", "required": true, "colSpan": 6, "options": [
            { "label": "Paid", "value": "paid" },
            { "label": "Partially Paid", "value": "partial" },
            { "label": "Pending", "value": "pending" },
            { "label": "Overdue", "value": "overdue" },
            { "label": "Voided", "value": "voided" }
          ]},
          { "name": "notes", "type": "textarea", "label": "Billing Notes", "colSpan": 12 }
        ]
      },
      "columns": [
        { "key": "invoiceNumber", "header": "Invoice #", "sortable": true, "width": "130px" },
        { "key": "studentName", "header": "Student", "sortable": true },
        { "key": "term", "header": "Term", "sortable": true, "width": "120px" },
        { "key": "totalAmount", "header": "Total ($)", "sortable": true, "width": "110px" },
        { "key": "paidAmount", "header": "Paid ($)", "sortable": true, "width": "110px" },
        { "key": "status", "header": "Status", "sortable": true, "width": "120px" },
        { "key": "dueDate", "header": "Due Date", "sortable": true, "width": "130px" }

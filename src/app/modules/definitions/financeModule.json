        "labelPlural": "Fee Structures",
        "fields": [
          { "name": "feeCode", "type": "text", "label": "Fee Code", "required": true, "colSpan": 6 },
          { "name": "name", "type": "text", "label": "Fee Description", "required": true, "colSpan": 6 },
          { "name": "category", "type": "select", "label": "Category", "required": true, "colSpan": 6, "options": [
            { "label": "Tuition Base", "value": "Tuition" },
            { "label": "Laboratory / Material", "value": "Lab" },
            { "label": "Technology & Facilities", "value": "Tech" },
            { "label": "Athletics & Activities", "value": "Activities" }

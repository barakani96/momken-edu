  "shortName": "Finance",
  "category": "Institutional Operations",
  "version": "1.8.0",
  "status": "active",
  "description": "Authoritative institutional financial management system for tuition billing, student accounts receivable, payment gateways, fee schedules, and scholarship disbursements.",

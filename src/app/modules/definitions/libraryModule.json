      "description": "Institutional online research subscriptions, IEEE Xplore, JSTOR access, and e-book repositories.",
      "schema": {
        "resource": "digitalResources",
        "label": "Digital Resource",
        "labelPlural": "Digital Resources",
        "fields": [
          { "name": "resourceCode", "type": "text", "label": "Resource Code", "required": true, "colSpan": 6 },
          { "name": "title", "type": "text", "label": "Resource Title / Database", "required": true, "colSpan": 6 },
          { "name": "provider", "type": "text", "label": "Content Provider", "required": true, "colSpan": 6 },
          { "name": "accessType", "type": "select", "label": "Access Model", "required": true, "colSpan": 6, "options": [

          { "name": "isbn", "type": "text", "label": "ISBN-13", "required": true, "colSpan": 6 },
          { "name": "title", "type": "text", "label": "Book Title", "required": true, "colSpan": 6 },
          { "name": "author", "type": "text", "label": "Author(s)", "required": true, "colSpan": 6 },

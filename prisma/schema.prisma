datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id               String            @id @default(uuid())
  studentNumber    String            @unique
  firstName        String
  lastName         String
  preferredName    String?
  firstNameAr      String?
  lastNameAr       String?
  gender           String
  dateOfBirth      String
  nationalId       String            @unique
  status           String            @default("active")
  enrollmentStatus String            @default("Enrolled")
  campus           String
  program          String
  gradeLevel       String
  classSection     String
  cohort           String
  gpa              Float             @default(3.75)
  enrollmentDate   String
  attendanceRate   Float             @default(97.5)
  email            String
  phone            String
  alternatePhone   String?
  street           String
  city             String
  state            String
  postalCode       String
  country          String
  guardians        Guardian[]
  documents        StudentDocument[]
  academicRecords  AcademicRecord[]
  timelineEvents   TimelineEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Guardian {
  id                     String   @id @default(uuid())
  studentId              String
  student                Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianName           String
  relationship           String
  phone                  String
  email                  String
  isPrimary              Boolean  @default(false)
  isEmergencyContact     Boolean  @default(false)
  isFinancialResponsible Boolean  @default(false)
  canPickup              Boolean  @default(true)
}

model StudentDocument {
  id                String   @id @default(uuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category          String
  documentType      String
  fileName          String
  fileSize          String
  uploadDate        String
  uploadedBy        String
  status            String   @default("Pending")
  serialNumber      String?
  academicYear      String?
  expiryDate        String?
  summary           String?
  verificationNotes String?
  downloadUrl       String?
}

model AcademicRecord {
  id              String   @id @default(uuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code            String
  nameEn          String
  nameAr          String
  term            String
  credits         Int
  courseworkScore Float
  finalExamScore  Float
  totalScore      Float
  grade           String
  instructor      String
  status          String   @default("In Progress")
}

model TimelineEvent {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String
  actor       String
  timestamp   String
}

model NavigationMenu {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items NavigationMenuItem[]

  @@index([isActive])
  @@index([tenantId])
  @@map("navigation_menus")
}

model NavigationMenuItem {
  id           String             @id @default(uuid())
  menuId       String
  parentId     String?
  key          String
  type         String             @default("LINK") // GROUP, LINK, EXTERNAL_LINK, DIVIDER
  label        String
  path         String?
  icon         String?
  permission   String?
  moduleKey    String?
  sortOrder    Int                @default(0)
  isVisible    Boolean            @default(true)
  isEnabled    Boolean            @default(true)
  openInNewTab Boolean            @default(false)
  metadata     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  menu         NavigationMenu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent       NavigationMenuItem?    @relation("NavigationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     NavigationMenuItem[]   @relation("NavigationTree")
  translations NavigationTranslation[]

  @@unique([menuId, key])
  @@index([menuId, parentId, sortOrder])
  @@index([permission])
  @@index([moduleKey])
  @@map("navigation_menu_items")
}

model NavigationTranslation {
  id          String   @id @default(uuid())
  itemId      String
  locale      String
  label       String
  description String?

  item NavigationMenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, locale])
  @@index([locale])
  @@map("navigation_translations")
}

model NavigationAuditLog {
  id         String   @id @default(uuid())
  action     String   // CREATE_MENU, UPDATE_MENU, DELETE_MENU, CREATE_ITEM, UPDATE_ITEM, DELETE_ITEM, REORDER_ITEMS
  entityId   String?
  actorId    String?
  actorEmail String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@map("navigation_audit_logs")
}
